{
  "name": "cfd-visualise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate:cpu-production": "vite-node scripts/generate-cpu-production-manifest.ts",
    "validate:webgpu-backend": "node scripts/generate-webgpu-backend-manifest.mjs",
    "validate:quality-tiers": "node scripts/generate-quality-tier-manifests.mjs",
    "check:evidence": "node scripts/check-validation-evidence.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:browser:smoke": "node scripts/run-browser-tests.mjs --project=chromium --project=firefox --project=webkit --project=chrome --grep-invert=\"real CPU guide\"",
    "test:guide:cpu": "node scripts/run-browser-tests.mjs tests/browser/guide-performance.e2e.ts --project=chromium",
    "test:guide:matrix": "node scripts/run-browser-tests.mjs tests/browser/guide-performance.e2e.ts --project=chromium --project=firefox --project=webkit",
    "test:guide:release": "node scripts/run-release-guide-tests.mjs",
    "test:firefox-webgpu": "node scripts/run-firefox-webgpu-test.mjs",
    "test": "vitest run --reporter=default --reporter=./scripts/test-dashboard/vitest-reporter.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/run-verification.mjs verify",
    "verify:engine": "node scripts/run-verification.mjs engine",
    "verify:evidence": "node scripts/run-verification.mjs evidence",
    "verify:release": "node scripts/run-verification.mjs release"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^29.1.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
