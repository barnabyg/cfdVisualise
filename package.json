{
  "name": "cfd-visualise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate:cpu-production": "vite-node scripts/generate-cpu-production-manifest.ts",
    "validate:webgpu-backend": "node scripts/generate-webgpu-backend-manifest.mjs",
    "validate:quality-tiers": "npm run validate:cpu-production && npm run validate:webgpu-backend",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^29.1.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
